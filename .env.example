# URL base da API (backend Rust/Axum). Inclui o prefixo /api/v1.
VITE_API_BASE_URL=http://127.0.0.1:3001/api/v1

# Push (Firebase Cloud Messaging). Sem estas variáveis o push fica desativado:
# o app não pede permissão nem registra device token. Valores no
# Firebase Console > Project settings.
# Aba General > seu app Web (objeto firebaseConfig):
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Aba Cloud Messaging > Web Push certificates > Generate key pair:
VITE_FCM_VAPID_KEY=
